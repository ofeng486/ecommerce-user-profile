# ═══ 电商用户画像分析系统 .gitignore ═══

# 构建产物
backend/target/
frontend/dist/

# 依赖
frontend/node_modules/

# 环境与密钥（禁止提交；.env.example 除外）
.env
.env.*
!.env.example

# 本地开发配置（含真实密钥，禁止提交）
backend/src/main/resources/application-local*.properties

# 本地生成数据与临时文件
generated-data/
*.log
tmp/
*.tmp

# 数据导出/测试输出（模拟数据不入库）
bigdata-scripts/test-output/
/数据导入总表_10个新用户.csv

# 个人文件（不入库）
简历/

# 工具/IDE 目录（本地工作记忆与配置不入库）
.workbuddy/
.reasonix/
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db

# 前端构建缓存（不应提交）
frontend/.vite/
