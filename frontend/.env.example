# ═══ 前端环境变量模板 ═══
# 本项目前端依赖 .env / .env.development / .env.production 三个环境文件。
# 但真实环境文件不入库。请将本文件复制并命名为以下三个文件使用：
#
#   cp frontend/.env.example frontend/.env
#   cp frontend/.env.example frontend/.env.development
#   cp frontend/.env.example frontend/.env.production
#
# 然后按需修改端口、API 地址。Vite 优先加载同名模式的 .env 文件。
# 下列配置均来自三个真实 env 文件的并集，均为通用配置，不含任何密钥。

# ─── 通用（.env）───
# 版本号
VITE_VERSION = 1.0.0

# 端口号（开发服务器监听端口）
VITE_PORT = 3006

# 应用部署基础路径（部署在子目录 /admin 时改为 /admin/）
VITE_BASE_URL = /

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = frontend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# ─── 开发（.env.development）───
# API 请求基础路径（相对路径，经 Vite 代理转发）
VITE_API_URL = /

# 代理目标地址（开发环境 Vite 将 /api 代理转发到此后端地址）
VITE_API_PROXY_URL = http://localhost:8080

# Delete console（开发阶段建议 false）
VITE_DROP_CONSOLE = false

# ─── 生产（.env.production）───
# API 地址前缀（生产部署时替换为实际后端地址）
# VITE_API_URL = http://your-backend-host:8080

# Delete console（生产建议 true）
VITE_DROP_CONSOLE = true
